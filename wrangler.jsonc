{
  // ==========================================================================
  // Cloudflare Workers 靜態網站設定
  //
  // 這個檔案讓 Cloudflare 從 GitHub 自動建置時，知道要把 dist/ 這個資料夾
  // 當成網站發佈出去。沒有它，Git 連接的建置會找不到要部署什麼。
  //
  // 手動部署（平常不需要，Cloudflare 會自動做）：
  //   npm run build && wrangler deploy
  // ==========================================================================

  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "harmonia-clinic",
  "compatibility_date": "2026-08-01",

  // 轉址程式：把 www 與 workers.dev 的網址 301 導到正式網域，
  // 其餘請求原封不動交給下面的靜態檔案處理。
  "main": "worker.js",

  "assets": {
    // 網站檔案在哪（由 npm run build 產生）
    "directory": "./dist",
    // 找不到頁面時，回傳我們自己的 404 頁
    "not_found_handling": "404-page",
    // 讓 worker.js 可以用 env.ASSETS 取用這些檔案
    "binding": "ASSETS",
    // 預設會「先找靜態檔案，找到就直接回傳」，這樣 worker.js 永遠不會執行、
    // 轉址也就不會生效。改成 true 表示每個請求都先交給 worker.js 判斷，
    // 不需要轉址的再由它交還給靜態檔案。
    "run_worker_first": true
  }
}
